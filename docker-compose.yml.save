version: '3'

services:

  python:
    build: ./python-docker-app

  node:
    build: ./node-docker-app

  laravel:
    build: ./laravel-project/laravel

  java:
    build: ./java-app

  nginx:
    build: ./nginx
    ports:
      - "80:80"
    depends_on:
      - python
      - node
      - laravel
      - java
  networks:
    app-network:
